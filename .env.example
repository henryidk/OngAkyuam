# Postgres (docker-compose local dev)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# apps/api (Prisma) — para correr el backend LOCAL con pnpm (fuera de Docker),
# apuntando al Postgres publicado en 127.0.0.1:${POSTGRES_PORT} por docker-compose.override.yml.
# Ejemplo: postgresql://usuario:password@127.0.0.1:5432/nombre_db?schema=public
# Si "api" corre dentro de Docker (docker compose --profile production up), no usa esta
# variable: docker-compose.yml arma su propia DATABASE_URL interna apuntando a "postgres:5432".
DATABASE_URL=

# apps/api
API_PORT=3000

# apps/api — JWT de doble token (access/refresh). Deben ser distintos entre sí,
# de al menos 32 caracteres cada uno. Generar con: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# apps/api — origen permitido para CORS (la SPA de apps/web). En dev local: http://localhost:5173
FRONTEND_URL=

# apps/web (Vite) — URL base del backend, con el prefijo /api. En dev local: http://localhost:3000/api
# Debe empezar con VITE_ para que Vite la exponga al código del navegador (no es secreta).
VITE_API_URL=

# apps/web (Vite) — origen del backend para el WebSocket de áreas de atención, SIN el
# prefijo /api (el gateway de Socket.IO no vive bajo setGlobalPrefix). En dev local:
# http://localhost:3000
VITE_WS_URL=

# apps/api — uid/gid del contenedor "api-dev" (docker-compose.override.yml), para que
# lo que escriba en el repo por bind mount (dist/, tsbuildinfo) quede con tu propio
# usuario en vez de root. Por defecto 1000:1000 (el usuario típico en Linux); solo
# hace falta declararlas si tu usuario tiene otro uid/gid (`id -u` / `id -g`).
DEV_UID=1000
DEV_GID=1000

# apps/api — Cloudflare R2 (almacenamiento de documentos escaneados). El SDK de AWS S3
# se usa como cliente porque R2 es compatible con el protocolo S3, pero apuntado a
# R2_ENDPOINT (no a Amazon; el account ID ya viene incluido en esa URL). Credenciales
# del token "R2 Account Token" en el dashboard de Cloudflare, permiso "Lectura y
# escritura de objetos" restringido al bucket akyuam.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# Redis (docker-compose local dev)
REDIS_PORT=6379

# apps/api (ioredis) — para correr el backend LOCAL con pnpm (fuera de Docker),
# apuntando al Redis publicado en 127.0.0.1:${REDIS_PORT} por docker-compose.override.yml.
# Ejemplo: redis://127.0.0.1:6379
# Si "api" corre dentro de Docker (docker compose --profile production up), no usa esta
# variable: docker-compose.yml arma su propia REDIS_URL interna apuntando a "redis:6379".
REDIS_URL=
