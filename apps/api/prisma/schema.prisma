generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  TRABAJO_SOCIAL
  JURIDICO
  PSICOLOGIA
  MEDICA
  ADMINISTRACION
}

model Usuario {
  id                 String   @id @default(uuid())
  nombreCompleto     String
  username           String   @unique
  passwordHash       String
  rol                Rol
  // Nullable a nivel de columna a propósito: los 5 usuarios ficticios del seed de login no
  // tienen estos datos reales, y no tiene sentido inventarlos. La obligatoriedad real (para
  // cuentas creadas desde Administración) vive en Zod (`crearUsuarioSchema`), no aquí.
  telefono           String?
  dpi                String?  @unique
  // Cargo dentro del área (ej. "ABOGADA", "DOCTORA") — null para ADMINISTRACION, que no
  // atiende casos. Texto libre igual que `Personal.tipo`: qué valores son válidos por área
  // se valida con Zod (`PUESTOS_POR_AREA`), no con un enum de Postgres.
  puesto             String?
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  refreshTokens                      RefreshToken[]
  expedientesCreados                 Expediente[]
  referidosOtorgados                 ReferidoArea[]                    @relation("ReferidoOtorgadoPor")
  referidosAsignados                 ReferidoArea[]                    @relation("ReferidoProfesionalAsignado")
  documentosSubidos                  Documento[]
  visibilidadesOtorgadas             DocumentoVisibilidadArea[]
  procesosJuridicosCreados           ProcesoJuridico[]
  notasAvanceRegistradas             NotaAvanceProceso[]
  documentosProcesoSubidos           DocumentoProceso[]
  abandonosRegistrados               AbandonoProceso[]
  suspensionesProcesoRegistradas     SuspensionProceso[]
  carpetasProcesoCreadas             CarpetaDocumentoProceso[]
  atencionesPsicologicasActualizadas AtencionPsicologica[]             @relation("AtencionPsicologicaActualizadaPor")
  atencionesPsicologicasAsignadas    AtencionPsicologica[]             @relation("AtencionPsicologicaAsignada")
  cambiosEstadoAtencionRegistrados   CambioEstadoAtencion[]            @relation("CambioEstadoAtencionRegistradoPor")
  reasignacionesPsicologiaCedidas    ReasignacionAtencionPsicologica[] @relation("ReasignacionPsicologiaDe")
  reasignacionesPsicologiaTomadas    ReasignacionAtencionPsicologica[] @relation("ReasignacionPsicologiaA")
  citasPsicologicasAtendidas         CitaPsicologica[]                 @relation("CitaPsicologicaAtendidaPor")
  atencionesMedicasCreadas           AtencionMedica[]                  @relation("AtencionMedicaCreadaPor")
  atencionesMedicasAsignadas         AtencionMedica[]                  @relation("AtencionMedicaMedica")
  citasMedicasCreadas                CitaMedica[]
  consultasMedicasRegistradas        ConsultaMedica[]
  documentosMedicosSubidos           DocumentoMedico[]
  documentosMedicosPendientes        DocumentoMedicoPendiente[]
  audienciasJuridicasCreadas         AudienciaJuridica[]
  fichaPersonal                      Personal?
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique // sha256 del JWT, nunca el token en claro
  usuarioId String
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @db.Timestamptz(3)
  revoked   Boolean   @default(false)
  revokedAt DateTime? @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([usuarioId]) // consulta frecuente: "todos los refresh tokens activos de este usuario" al desactivar/resetear
}

model AuditLog {
  id        String   @id @default(uuid())
  usuarioId String?
  username  String?
  accion    String // LOGIN_SUCCESS, LOGIN_FAILED, LOGOUT, USER_CREATED, PASSWORD_RESET, USER_DEACTIVATED, ...
  entidad   String? // pensado a futuro para auditar acceso a expedientes/documentos, no solo auth
  entidadId String?
  ipAddress String?
  userAgent String?
  detalles  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([usuarioId])
  @@index([accion, createdAt]) // reportes/filtros por tipo de evento y rango de fecha
  @@index([entidad, entidadId, createdAt]) // bitácora del expediente y novedades de la bandeja
}

enum TipoRegistro {
  INTERNA
  EXTERNA
}

enum GeneroPersona {
  MUJER
  HOMBRE
}

enum GrupoEtnico {
  MAYA_QECHI
  MAYA_POQOMCHI
  XINCA
  GARIFUNA
  LADINO
  OTRO
}

enum TipologiaDelito {
  FISICA
  PSICOLOGICA
  ECONOMICA_PATRIMONIAL
  SEXUAL
}

enum MunicipioAltaVerapaz {
  COBAN
  SANTA_CRUZ_VERAPAZ
  SAN_CRISTOBAL_VERAPAZ
  TACTIC
  TAMAHU
  TUCURU
  PANZOS
  SENAHU
  SAN_PEDRO_CARCHA
  SAN_JUAN_CHAMELCO
  LANQUIN
  CAHABON
  CHISEC
  CHAHAL
  FRAY_BARTOLOME_DE_LAS_CASAS
  RAXRUHA
  SANTA_CATALINA_LA_TINTA
}

// Identidad de la persona atendida — capturada una sola vez, reutilizada
// entre expedientes (RNF-09, RF-08).
model Usuaria {
  id                  String                @id @default(uuid())
  dpi                 String?               @unique // único cuando existe; NULL permitido varias veces (mujeres sin DPI)
  nombres             String
  apellidos           String
  telefono            String?
  direccion           String?
  // Datos de dónde vive la usuaria — identidad, no del caso puntual: se capturan una vez y se
  // editan explícitamente si cambian (ver Usuarios → Expediente → "editar datos"), nunca se
  // vuelven a pedir al registrar un caso nuevo de una usuaria ya existente.
  municipio           MunicipioAltaVerapaz?
  departamentoOtro    String? // excepción: usuaria de fuera de Alta Verapaz
  municipioOtro       String?
  ubicacionGeografica String? // aldea/zona/colonia, texto libre
  fechaNacimiento     DateTime              @db.Date
  grupoEtnico         GrupoEtnico
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)

  expedientes Expediente[]

  @@index([apellidos, nombres]) // recorrido ordenado; la búsqueda difusa usa el índice trigram (ver migración)
  @@index([municipio])
}

model Expediente {
  id                   String            @id @default(uuid())
  numero               String            @unique // "NN-AAAA", ver ExpedienteContador
  usuariaId            String
  usuaria              Usuaria           @relation(fields: [usuariaId], references: [id])
  fecha                DateTime          @db.Date
  tipoRegistro         TipoRegistro
  tipologiaDelito      TipologiaDelito[]
  observaciones        String?           @db.Text
  // Solo INTERNA. Fechas de calendario (no instantes): se capturan del formulario en papel.
  fechaIngresoAlbergue DateTime?         @db.Date
  fechaEgresoAlbergue  DateTime?         @db.Date
  creadoPorId          String
  creadoPor            Usuario           @relation(fields: [creadoPorId], references: [id])
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)

  agresor                Agresor?
  ninos                  Nino[]
  referidos              ReferidoArea[]
  documentos             Documento[]
  procesosJuridicos      ProcesoJuridico[]
  atencionesPsicologicas AtencionPsicologica[]
  atencionesMedicas      AtencionMedica[]

  @@index([usuariaId])
  @@index([fecha])
  @@index([creadoPorId])
}

// Otorga acceso de solo lectura a un área de atención (subconjunto de Rol: JURIDICO,
// PSICOLOGIA, MEDICA — validado en capa de aplicación) sobre un expediente puntual.
// Ver CLAUDE.md: "Cada área solo ve lo que trabajo social le autoriza explícitamente".
model ReferidoArea {
  id                    String     @id @default(uuid())
  expedienteId          String
  expediente            Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  area                  Rol
  otorgadoPorId         String
  otorgadoPor           Usuario    @relation("ReferidoOtorgadoPor", fields: [otorgadoPorId], references: [id])
  createdAt             DateTime   @default(now()) @db.Timestamptz(3)
  motivo                String?    @db.Text
  // Usuario del área (psicóloga, doctora); null = queda en la cola del área.
  profesionalAsignadoId String?
  profesionalAsignado   Usuario?   @relation("ReferidoProfesionalAsignado", fields: [profesionalAsignadoId], references: [id])
  // Agresor, tipología y observaciones. Jurídico los ve siempre (ver PoliticaJuridico).
  puedeVerDatosCaso     Boolean    @default(true)

  // Solo Jurídico. Una referencia está pendiente mientras no se atienda; se atiende al
  // registrar el primer lote de procesos desde ella.
  atendidoEn             DateTime?             @db.Timestamptz(3)
  procesosJuridicos      ProcesoJuridico[]
  atencionesPsicologicas AtencionPsicologica[]
  atencionesMedicas      AtencionMedica[]

  @@unique([expedienteId, area])
  @@index([area])
}

model Agresor {
  id           String     @id @default(uuid())
  expedienteId String     @unique
  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  nombres      String?
  apellidos    String?
  telefono     String?
  direccion    String?
}

model Nino {
  id              String        @id @default(uuid())
  expedienteId    String
  expediente      Expediente    @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  nombres         String
  apellidos       String
  fechaNacimiento DateTime      @db.Date
  genero          GeneroPersona

  citasPsicologicas CitaPsicologica[]
  citasMedicas      CitaMedicaPersona[]
  consultasMedicas  ConsultaMedica[]

  @@index([expedienteId])
}

// Consecutivo atómico por año para el número de expediente "NN-AAAA".
model ExpedienteContador {
  anio   Int @id
  ultimo Int @default(0)
}

enum TipoDocumento {
  ENTREVISTA_USUARIA
  CONVENIO_INGRESO
  RECEPCION_BIENES
  FORMATO_ATENCION_PSICOLOGICA
  CONVENIO_EGRESO
  ACCIONES_REALIZADAS
}

model Documento {
  id            String        @id @default(uuid())
  expedienteId  String
  expediente    Expediente    @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  tipo          TipoDocumento
  nombreArchivo String // nombre original, solo para mostrar en UI — nunca se usa como parte de la clave en R2
  claveR2       String        @unique // object key generado por el backend (uuid), nunca derivado de input del usuario
  mimeType      String
  tamanioBytes  Int
  subidoPorId   String
  subidoPor     Usuario       @relation(fields: [subidoPorId], references: [id])
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  // Versionado de los formularios de Trabajo Social: "Actualizar" nunca borra, crea la
  // versión siguiente y marca esta como no vigente. `reemplazaAId` @unique impide que dos
  // subidas concurrentes reemplacen la misma versión.
  version        Int        @default(1)
  vigente        Boolean    @default(true)
  reemplazaAId   String?    @unique
  reemplazaA     Documento? @relation("VersionDocumento", fields: [reemplazaAId], references: [id])
  reemplazadoPor Documento? @relation("VersionDocumento")

  visibilidadAreas DocumentoVisibilidadArea[]

  // Vínculo opcional al "Formato General" escaneado de una cita de psicología. SetNull (no
  // Cascade): si se elimina la cita, el documento no debe desaparecer — sigue siendo parte
  // del expediente y de su propio ciclo de vida vía `expedienteId`.
  citaPsicologicaId String?
  citaPsicologica   CitaPsicologica? @relation(fields: [citaPsicologicaId], references: [id], onDelete: SetNull)

  @@index([expedienteId])
  @@index([citaPsicologicaId])
  @@index([expedienteId, tipo, vigente])
}

// Visibilidad de un documento para un área — permiso explícito y separado de ReferidoArea.
// Ver CLAUDE.md: "área solo ve... archivos subidos solo si trabajo social habilitó
// visibilidad para esa área en particular". Todo privado por defecto.
model DocumentoVisibilidadArea {
  id            String    @id @default(uuid())
  documentoId   String
  documento     Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  area          Rol
  otorgadoPorId String
  otorgadoPor   Usuario   @relation(fields: [otorgadoPorId], references: [id])
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([documentoId, area])
  @@index([area])
}

// Catálogo de personal por área (abogadas/procuradoras en jurídico, y a futuro los cargos
// que definan psicológica/médica/trabajo social), gestionado desde Administración. Una sola
// tabla genérica en vez de una por área: `area` reusa el mismo enum `Rol` que ya discrimina
// áreas en `ReferidoArea`, y `tipo` es texto libre (no un enum de Postgres) porque cada área
// define sus propios cargos con el tiempo — agregar un cargo nuevo no debe exigir una
// migración de esquema. Qué valores de `tipo` son válidos para cada área se valida con Zod
// en el módulo de esa área (ver `packages/shared/src/schemas/juridico.ts`), no aquí.
// Se desactiva en vez de borrar para no romper el historial de procesos ya asociados.
model Personal {
  id        String   @id @default(uuid())
  area      Rol
  tipo      String
  nombre    String
  activo    Boolean  @default(true)
  // Cuenta con la que esta persona inicia sesión: permite "Mis procesos" y "Solo asignados
  // a mí". Opcional porque hay fichas creadas antes de este vínculo; Administración las
  // enlaza a mano. Una cuenta tiene como máximo una ficha.
  usuarioId String?  @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  usuario                   Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  procesosComoAbogada       ProcesoJuridico[]   @relation("AbogadaDeProceso")
  procesosComoProcuradora   ProcesoJuridico[]   @relation("ProcuradoraDeProceso")
  audienciasComoResponsable AudienciaJuridica[] @relation("ResponsableAudiencia")

  @@index([area, tipo, activo])
}

enum TipoProcesoJuridico {
  FIJACION_PENSION_ALIMENTICIA
  MODIFICACION_PENSION_ALIMENTICIA
  DIVORCIO_MUTUO_ACUERDO
  DIVORCIO_CAUSAL_DETERMINADA
  PATERNIDAD_FILIACION
  EJECUCION_VIA_APREMIO
  JUICIO_EJECUTIVO
  GUARDA_CUSTODIA
  MEDIDAS_SEGURIDAD
  MENAJE_CASA
  RELACIONES_FAMILIARES
  RECONOCIMIENTO_PRENEZ_PARTO
  REFERENCIA_PGN
  ORDINARIO_LABORAL
  INSCRIPCION_RENAP
}

// Avance del proceso: solo camina hacia adelante. Los procesos nacen EN_PROCESO; INICIADO se
// conserva como primer paso del indicador de avance y para el historial.
enum FaseProcesoJuridico {
  INICIADO
  EN_PROCESO
  FINALIZADO
}

// Si el caso se está trabajando — eje independiente de la fase.
enum SituacionProcesoJuridico {
  ACTIVO
  SUSPENDIDO
  ABANDONADO
}

enum FormaFinalizacionProceso {
  CONVENIO
  SENTENCIA
  DESISTIMIENTO
  OTROS
}

enum MotivoAbandonoProceso {
  NO_RESPONDE
  CAMBIO_DOMICILIO
  ABOGADO_PARTICULAR
  RECONCILIACION
  NO_SE_PRESENTO_AUDIENCIAS
  OTRO
}

// Un proceso judicial que jurídico lleva para una usuaria dentro de un expediente que le fue
// referido. Una usuaria puede tener varios procesos, incluso del mismo tipo repetido en el
// tiempo (ej. fijación y luego modificación de la misma pensión alimenticia).
model ProcesoJuridico {
  id                  String                    @id @default(uuid())
  expedienteId        String
  expediente          Expediente                @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  tipo                TipoProcesoJuridico
  // El No. interno visible ("05-2026" o, desde el segundo, "05-2026 · Proceso 2") se deriva
  // con `etiquetaProceso`, no se guarda.
  consecutivo         Int
  fase                FaseProcesoJuridico       @default(EN_PROCESO)
  situacion           SituacionProcesoJuridico  @default(ACTIVO)
  formaFinalizacion   FormaFinalizacionProceso?
  detalleFinalizacion String?                   @db.VarChar(300)
  numeroJudicial      String?                   @db.VarChar(60)
  organoJudicial      String?                   @db.VarChar(160)
  contraparte         String?                   @db.VarChar(160)
  // "Vincular con proceso anterior" (ej. la ejecución de una pensión ya fijada).
  procesoOrigenId     String?
  procesoOrigen       ProcesoJuridico?          @relation("VinculoProceso", fields: [procesoOrigenId], references: [id], onDelete: SetNull)
  derivados           ProcesoJuridico[]         @relation("VinculoProceso")
  // Referencia de Trabajo Social que lo originó; null si se registró desde la ficha.
  referidoId          String?
  referido            ReferidoArea?             @relation(fields: [referidoId], references: [id], onDelete: SetNull)
  ultimaActuacionEn   DateTime                  @default(now()) @db.Timestamptz(3)
  // Concurrencia optimista: cada escritura exige la versión leída y la incrementa.
  version             Int                       @default(1)
  abogadaId           String?
  abogada             Personal?                 @relation("AbogadaDeProceso", fields: [abogadaId], references: [id])
  procuradoraId       String?
  procuradora         Personal?                 @relation("ProcuradoraDeProceso", fields: [procuradoraId], references: [id])
  fechaInicio         DateTime                  @db.Date
  fechaCierre         DateTime?                 @db.Date
  creadoPorId         String
  creadoPor           Usuario                   @relation(fields: [creadoPorId], references: [id])
  createdAt           DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(3)

  notas        NotaAvanceProceso[]
  documentos   DocumentoProceso[]
  abandonos    AbandonoProceso[]
  suspensiones SuspensionProceso[]
  carpetas     CarpetaDocumentoProceso[]
  audiencias   AudienciaJuridica[]

  @@unique([expedienteId, consecutivo])
  @@index([fase, situacion])
  @@index([formaFinalizacion])
  @@index([ultimaActuacionEn])
}

// Abandono del proceso por inasistencia de la usuaria — evento aparte, no un estado: puede
// registrarse sobre un proceso en cualquier momento, sin importar su estado actual (decisión
// de negocio confirmada, ver planjuridico.md).
model AbandonoProceso {
  id               String                @id @default(uuid())
  procesoId        String
  proceso          ProcesoJuridico       @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  fecha            DateTime              @db.Date
  // Observaciones en texto libre; el motivo clasificado es `motivoCatalogo`.
  motivo           String?
  motivoCatalogo   MotivoAbandonoProceso
  ultimoContacto   DateTime?             @db.Date
  intentosContacto Int                   @default(0)
  notificadoATs    Boolean               @default(false)
  // null = abandono vigente. Al reactivar el proceso se conserva la fila como historial.
  reactivadoEn     DateTime?             @db.Timestamptz(3)
  registradoPorId  String
  registradoPor    Usuario               @relation(fields: [registradoPorId], references: [id])
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)

  // "Un solo abandono vigente por proceso" lo garantiza un índice único parcial creado a
  // mano en la migración juridico_restricciones (Prisma no los expresa).
  @@index([procesoId])
}

// Pausa temporal de un proceso (ej. a la espera de un documento). Historial: al reactivar se
// cierra con `hasta`, no se borra.
model SuspensionProceso {
  id              String          @id @default(uuid())
  procesoId       String
  proceso         ProcesoJuridico @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  motivo          String          @db.VarChar(300)
  desde           DateTime        @default(now()) @db.Timestamptz(3)
  hasta           DateTime?       @db.Timestamptz(3) // null = vigente
  registradoPorId String
  registradoPor   Usuario         @relation(fields: [registradoPorId], references: [id])

  @@index([procesoId])
}

model NotaAvanceProceso {
  id              String          @id @default(uuid())
  procesoId       String
  proceso         ProcesoJuridico @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  contenido       String
  // Texto libre: cada proceso tiene actuaciones distintas ("Memorial de evacuación", …).
  tipo            String          @db.VarChar(60)
  // Solo el backend crea entradas de sistema (creación, cambios de estado, subida de documentos).
  esSistema       Boolean         @default(false)
  registradoPorId String
  registradoPor   Usuario         @relation(fields: [registradoPorId], references: [id])
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)

  documentos DocumentoProceso[]

  @@index([procesoId, createdAt])
}

// Carpeta de documentos de un proceso, con nombre libre. `nombreNorm` (minúsculas, sin
// espacios a los lados) es lo que decide si dos nombres son el mismo.
model CarpetaDocumentoProceso {
  id          String             @id @default(uuid())
  procesoId   String
  proceso     ProcesoJuridico    @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  nombre      String             @db.VarChar(80)
  nombreNorm  String             @db.VarChar(80)
  creadaPorId String
  creadaPor   Usuario            @relation(fields: [creadaPorId], references: [id])
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  documentos  DocumentoProceso[]

  @@unique([procesoId, nombreNorm])
}

// Documento propio de un proceso jurídico. `nombreVisible` es el identificador elegido por
// quien lo sube (ej. "Demanda inicial", "Constancia de notificación") — distinto de
// `nombreArchivo`, el nombre original del archivo. Mismo criterio que `Documento`: `claveR2`
// nunca se deriva de input del usuario.
model DocumentoProceso {
  id            String                  @id @default(uuid())
  procesoId     String
  proceso       ProcesoJuridico         @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  nombreVisible String
  nombreArchivo String
  claveR2       String                  @unique
  mimeType      String
  tamanioBytes  Int
  subidoPorId   String
  subidoPor     Usuario                 @relation(fields: [subidoPorId], references: [id])
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)
  carpetaId     String
  carpeta       CarpetaDocumentoProceso @relation(fields: [carpetaId], references: [id], onDelete: Restrict)
  // Documento propio de una audiencia (acta, citación, constancia). Sigue siendo un documento
  // del proceso: vive en una carpeta y se ve en la pestaña Documentos. Restrict: una audiencia
  // con documentos nunca se borra.
  audienciaId   String?
  audiencia     AudienciaJuridica?      @relation(fields: [audienciaId], references: [id], onDelete: Restrict)
  // Documento de una actuación de la bitácora (el memorial, la resolución). Igual que los de
  // audiencia, vive en una carpeta. NoAction y no Restrict: al borrar el proceso se borran en
  // cascada tanto la actuación como el documento, y NoAction revisa la referencia al final de
  // la sentencia, cuando ambos ya se fueron. Una actuación sola nunca se borra desde la app.
  actuacionId   String?
  actuacion     NotaAvanceProceso?      @relation(fields: [actuacionId], references: [id], onDelete: NoAction)

  @@index([procesoId])
  @@index([carpetaId])
  @@index([audienciaId])
  @@index([actuacionId])
}

enum EstadoAudiencia {
  PROGRAMADA
  REALIZADA
  // El juzgado la suspendió, no se presentó una parte, etc.
  NO_REALIZADA
  CANCELADA
  // Se movió: la fecha nueva es la audiencia que la referencia.
  REPROGRAMADA
}

// Por qué se canceló: distingue la cancelación manual de la que provoca cerrar el proceso.
enum OrigenCancelacionAudiencia {
  MANUAL
  PROCESO_FINALIZADO
  PROCESO_ABANDONADO
}

// Audiencia judicial de un proceso. `inicio` es un instante (hora de Guatemala al capturar,
// UTC al guardar), sin duración. "Hoy" y "Pendiente de resultado" no se guardan: se derivan de
// `inicio` y del reloj. Las restricciones que Prisma no sabe declarar (una sola PROGRAMADA por
// responsable e instante, minuto exacto, motivo obligatorio, etc.) viven en el SQL de la
// migración `juridico_audiencias`. Ver planaudiencias.md §5 y §6.
model AudienciaJuridica {
  id                  String                      @id @default(uuid())
  procesoId           String
  // Restrict y no Cascade: una audiencia es historia judicial de la usuaria y nunca se borra,
  // así que un proceso con audiencias (y su expediente) tampoco se puede borrar.
  proceso             ProcesoJuridico             @relation(fields: [procesoId], references: [id], onDelete: Restrict)
  inicio              DateTime                    @db.Timestamptz(3)
  responsableId       String
  responsable         Personal                    @relation("ResponsableAudiencia", fields: [responsableId], references: [id], onDelete: Restrict)
  estado              EstadoAudiencia             @default(PROGRAMADA)
  // "Conciliación", "Recepción de pruebas".
  descripcion         String?                     @db.VarChar(80)
  // Lo ocurrido; se registra con el resultado y se puede completar después. La app lo limita a
  // 4000 caracteres.
  observaciones       String?                     @db.Text
  // Motivo de cancelación, de no realización o de reprogramación (obligatorio en esos estados).
  motivo              String?                     @db.VarChar(300)
  origenCancelacion   OrigenCancelacionAudiencia?
  reprogramadaDesdeId String?                     @unique
  reprogramadaDesde   AudienciaJuridica?          @relation("ReprogramacionAudiencia", fields: [reprogramadaDesdeId], references: [id], onDelete: Restrict)
  reprogramadaA       AudienciaJuridica?          @relation("ReprogramacionAudiencia")
  resultadoEn         DateTime?                   @db.Timestamptz(3)
  // Concurrencia optimista: cada escritura exige la versión leída y la incrementa.
  version             Int                         @default(1)
  creadoPorId         String
  creadoPor           Usuario                     @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  createdAt           DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                    @updatedAt @db.Timestamptz(3)

  documentos DocumentoProceso[]

  @@index([procesoId, inicio])
  @@index([responsableId, inicio])
  @@index([inicio])
}

enum EstadoAtencionPsicologica {
  INICIO
  SEGUIMIENTO
  CIERRE
}

// Estado de seguimiento clínico de psicología para un expediente referido — 1:1 con
// Expediente y no con ReferidoArea porque este concepto es exclusivo de psicología y no debe
// filtrarse a la tabla genérica que comparten jurídico/médica.
//
// `psicologaAsignadaId` no es solo un dato organizativo: es la llave de autorización del
// módulo completo de psicología (ver psicologianuevoplan.md §7.4). Trabajo social refiere el
// caso al área, no a una psicóloga — mientras sea `null` el expediente aparece en la cola de
// "Referencias sin tomar", visible a toda el área. La primera psicóloga que reclama el caso
// (`POST /psicologia/expedientes/:id/tomar`, UPDATE atómico condicionado a `IS NULL`) se
// convierte en su dueña exclusiva: a partir de ahí ninguna otra psicóloga puede leer ni
// escribir nada de este expediente (403 genérico, sin distinguir el motivo).
model AtencionPsicologica {
  id                   String                    @id @default(uuid())
  // Un expediente puede tener varios procesos (la usuaria regresa); la base solo deja uno sin
  // cerrar a la vez (índice parcial "AtencionPsicologica_activa_uq", fuera del alcance de Prisma).
  expedienteId         String
  expediente           Expediente                @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  estado               EstadoAtencionPsicologica @default(INICIO)
  psicologaAsignadaId  String?
  psicologaAsignada    Usuario?                  @relation("AtencionPsicologicaAsignada", fields: [psicologaAsignadaId], references: [id])
  tomadaEn             DateTime?                 @db.Timestamptz(3)
  fechaInicio          DateTime?                 @db.Timestamptz(3)
  fechaCierre          DateTime?                 @db.Timestamptz(3)
  // El código visible "P{consecutivo}-{numero de expediente}" se deriva, no se guarda.
  consecutivo          Int                       @default(1)
  motivoCierreCatalogo MotivoCierrePsicologia?
  // Texto de la psicóloga al cerrar (obligatorio si el motivo es OTRO). La app lo limita a 2000.
  resumenCierre        String?                   @db.Text
  // Si Jurídico / Médica ven etapa, fechas y documentos del proceso. Trabajo Social siempre
  // los ve; las notas de sesión no salen de Psicología en ningún caso.
  visibleJuridico      Boolean                   @default(false)
  visibleMedica        Boolean                   @default(false)
  // Referencia de Trabajo Social que lo originó; null si se abrió desde la ficha de la usuaria.
  referidoId           String?
  referido             ReferidoArea?             @relation(fields: [referidoId], references: [id], onDelete: SetNull)
  // Concurrencia optimista: cada escritura exige la versión leída y la incrementa.
  version              Int                       @default(1)
  actualizadoPorId     String
  actualizadoPor       Usuario                   @relation("AtencionPsicologicaActualizadaPor", fields: [actualizadoPorId], references: [id])
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(3)

  citas          CitaPsicologica[]
  cambiosEstado  CambioEstadoAtencion[]
  reasignaciones ReasignacionAtencionPsicologica[]

  @@unique([expedienteId, consecutivo])
  @@index([psicologaAsignadaId])
  @@index([referidoId])
}

enum MotivoCierrePsicologia {
  OBJETIVOS_CUMPLIDOS
  DEJO_DE_ASISTIR
  REFERIDA_OTRA_INSTITUCION
  DECISION_USUARIA
  OTRO
}

// Historial de hitos del proceso clínico (INICIO → SEGUIMIENTO → CIERRE), separado de
// `AtencionPsicologica.estado` (que solo guarda el estado actual) para poder reconstruir cuándo
// y por qué cambió — ver psicologianuevoplan.md §6.1.
// Cada vez que un proceso abierto cambia de psicóloga (la anterior quedó con la cuenta
// desactivada y otra lo tomó). Es el historial que se muestra en el detalle del proceso; solo
// se agregan filas, nunca se editan ni se borran.
model ReasignacionAtencionPsicologica {
  id            String              @id @default(uuid())
  atencionId    String
  atencion      AtencionPsicologica @relation(fields: [atencionId], references: [id], onDelete: Cascade)
  dePsicologaId String
  dePsicologa   Usuario             @relation("ReasignacionPsicologiaDe", fields: [dePsicologaId], references: [id])
  aPsicologaId  String
  aPsicologa    Usuario             @relation("ReasignacionPsicologiaA", fields: [aPsicologaId], references: [id])
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  @@index([atencionId])
}

model CambioEstadoAtencion {
  id              String                     @id @default(uuid())
  atencionId      String
  atencion        AtencionPsicologica        @relation(fields: [atencionId], references: [id], onDelete: Cascade)
  estadoAnterior  EstadoAtencionPsicologica?
  estadoNuevo     EstadoAtencionPsicologica
  motivo          String?                    @db.Text
  registradoPorId String
  registradoPor   Usuario                    @relation("CambioEstadoAtencionRegistradoPor", fields: [registradoPorId], references: [id])
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)

  @@index([atencionId])
}

enum ModalidadCita {
  PRESENCIAL
  VIRTUAL
}

enum EstadoCitaPsicologica {
  PROGRAMADA
  ATENDIDA
  CANCELADA
  NO_ASISTIO
  REPROGRAMADA
}

enum TipoCitaPsicologica {
  PRIMERA_ATENCION
  SEGUIMIENTO
  CIERRE
}

// `fechaHora` es un instante real (cuándo ocurre la cita), no una fecha de calendario — se
// guarda en UTC (Timestamptz) y se muestra convertida a America/Guatemala vía
// packages/shared/src/timezone.ts, igual que el resto del sistema.
// `atendidoPorId` referencia directamente al Usuario que atendió (cada psicóloga tiene su
// propia cuenta) — a diferencia de jurídico, aquí no hay catálogo Personal separado.
model CitaPsicologica {
  id                  String                @id @default(uuid())
  atencionId          String
  atencion            AtencionPsicologica   @relation(fields: [atencionId], references: [id], onDelete: Cascade)
  fechaHora           DateTime              @db.Timestamptz(3)
  // La atención es solo presencial en la ONG: el rediseño ya no pide modalidad, lugar ni motivo
  // de la cita. Los defaults dejan que las citas nuevas se creen sin ellos.
  modalidad           ModalidadCita         @default(PRESENCIAL)
  lugar               String?
  motivo              String                @default("")
  // Hijo/a que se atiende dentro del proceso de la madre; null = la usuaria.
  ninoId              String?
  nino                Nino?                 @relation(fields: [ninoId], references: [id], onDelete: SetNull)
  tipo                TipoCitaPsicologica   @default(SEGUIMIENTO)
  duracionMinutos     Int                   @default(45)
  estado              EstadoCitaPsicologica @default(PROGRAMADA)
  observaciones       String?               @db.Text
  acuerdos            String?               @db.Text
  motivoNoAsistencia  String?               @db.Text
  temas               String?               @db.Text
  intervencion        String?               @db.Text
  recomendaciones     String?               @db.Text
  borrador            Boolean               @default(false)
  reprogramadaDesdeId String?               @unique
  reprogramadaDesde   CitaPsicologica?      @relation("Reprogramacion", fields: [reprogramadaDesdeId], references: [id])
  reprogramadaHacia   CitaPsicologica?      @relation("Reprogramacion")
  atendidoPorId       String
  atendidoPor         Usuario               @relation("CitaPsicologicaAtendidaPor", fields: [atendidoPorId], references: [id])
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)

  documentos Documento[]

  @@index([atencionId, fechaHora])
  @@index([fechaHora])
  @@index([ninoId])
}

// ---- Medicina ----
// Lo clínico nunca se borra (`onDelete: Restrict`): cancelar o dar de alta es un cambio de
// estado. Los índices parciales y los CHECK de estas tablas viven en la migración
// `medica_restricciones` porque Prisma no sabe declararlos.

enum EstadoAtencionMedica {
  ACTIVA
  ALTA
}

enum MotivoAltaMedica {
  ALTA_MEDICA
  REFERIDA_OTRA_INSTITUCION
  DEJO_DE_ASISTIR
  OTRO
}

enum EstadoCitaMedica {
  PROGRAMADA
  ATENDIDA
  NO_ASISTIO
  CANCELADA
}

// Episodio de atención médica de un expediente. Se abre al agendar la primera consulta; la base
// solo deja una ACTIVA por expediente ("AtencionMedica_activa_uq"). El código visible
// "M{consecutivo}-{numero de expediente}" se deriva, no se guarda.
model AtencionMedica {
  id                String               @id @default(uuid())
  expedienteId      String
  expediente        Expediente           @relation(fields: [expedienteId], references: [id], onDelete: Restrict)
  consecutivo       Int
  estado            EstadoAtencionMedica @default(ACTIVA)
  // Referencia de Trabajo Social que la originó.
  referidoId        String?
  referido          ReferidoArea?        @relation(fields: [referidoId], references: [id], onDelete: SetNull)
  // Hoy hay una sola médica; la columna deja lista la asignación si llegaran a ser varias.
  medicaId          String?
  medica            Usuario?             @relation("AtencionMedicaMedica", fields: [medicaId], references: [id], onDelete: Restrict)
  fechaInicio       DateTime             @db.Date
  fechaAlta         DateTime?            @db.Date
  motivoAlta        MotivoAltaMedica?
  notaAlta          String?              @db.VarChar(500)
  // Lo que Medicina comparte con Jurídico (fechas y constancias) y Psicología (fechas).
  visibleJuridico   Boolean              @default(false)
  visiblePsicologia Boolean              @default(false)
  // Concurrencia optimista: cada escritura exige la versión leída y la incrementa.
  version           Int                  @default(1)
  creadoPorId       String
  creadoPor         Usuario              @relation("AtencionMedicaCreadaPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @db.Timestamptz(3)

  citas     CitaMedica[]
  consultas ConsultaMedica[]

  @@unique([expedienteId, consecutivo])
  @@index([estado])
  @@index([referidoId])
}

// Cita de 30 minutos. Un horario solo admite una cita PROGRAMADA o ATENDIDA
// ("CitaMedica_horario_uq"); EN_CURSO y SIN_REGISTRAR se derivan del reloj.
model CitaMedica {
  id                  String           @id @default(uuid())
  atencionId          String
  atencion            AtencionMedica   @relation(fields: [atencionId], references: [id], onDelete: Restrict)
  inicio              DateTime         @db.Timestamptz(3)
  // 30, 60 o 90 (CHECK en la migración). Dos citas vigentes no se traslapan: restricción de
  // exclusión gist sobre [inicio, inicio + duracionMin) en la migración medica_citas_familiares.
  duracionMin         Int              @default(30)
  estado              EstadoCitaMedica @default(PROGRAMADA)
  reprogramadaDesdeId String?          @unique
  reprogramadaDesde   CitaMedica?      @relation("ReprogramacionMedica", fields: [reprogramadaDesdeId], references: [id], onDelete: Restrict)
  reprogramadaA       CitaMedica?      @relation("ReprogramacionMedica")
  version             Int              @default(1)
  creadoPorId         String
  creadoPor           Usuario          @relation(fields: [creadoPorId], references: [id], onDelete: Restrict)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(3)

  personas  CitaMedicaPersona[]
  consultas ConsultaMedica[]

  @@index([inicio])
  @@index([atencionId, estado])
}

// Personas que se atienden en una cita (visita familiar): la usuaria (ninoId null) y/o sus
// hijos/as. Cada una tiene su propio registro de consulta. Único por (citaId, ninoId) con
// índices únicos parciales (migración medica_unicos_parciales_persona) para que la usuaria
// (ninoId null) no aparezca dos veces.
model CitaMedicaPersona {
  id     String     @id @default(uuid())
  citaId String
  cita   CitaMedica @relation(fields: [citaId], references: [id], onDelete: Cascade)
  // Debe ser del mismo expediente (se valida en el servicio).
  ninoId String?
  nino   Nino?      @relation(fields: [ninoId], references: [id], onDelete: Restrict)

  @@index([citaId])
  @@index([ninoId])
}

// Consulta registrada. Los rangos de los signos vitales los valida también un CHECK
// ("ConsultaMedica_rangos_chk") con los mismos valores de `RANGOS_SIGNOS_VITALES` en shared.
model ConsultaMedica {
  id                 String         @id @default(uuid())
  atencionId         String
  atencion           AtencionMedica @relation(fields: [atencionId], references: [id], onDelete: Restrict)
  // Una consulta por persona de la cita: único por (citaId, ninoId), con índices parciales en la
  // migración medica_unicos_parciales_persona (las consultas sin cita no chocan entre sí).
  citaId             String?
  cita               CitaMedica?    @relation(fields: [citaId], references: [id], onDelete: Restrict)
  ninoId             String?
  nino               Nino?          @relation(fields: [ninoId], references: [id], onDelete: Restrict)
  fechaHora          DateTime       @db.Timestamptz(3)
  motivoConsulta     String?        @db.VarChar(2000)
  presionSistolica   Int?           @db.SmallInt
  presionDiastolica  Int?           @db.SmallInt
  frecuenciaCardiaca Int?           @db.SmallInt
  frecuenciaResp     Int?           @db.SmallInt
  temperaturaC       Decimal?       @db.Decimal(4, 1)
  saturacionO2       Int?           @db.SmallInt
  glucosaMgDl        Int?           @db.SmallInt
  pesoKg             Decimal?       @db.Decimal(5, 2)
  tallaM             Decimal?       @db.Decimal(3, 2)
  diagnostico        String         @db.VarChar(2000)
  planTratamiento    String?        @db.VarChar(4000)
  recetaLaboratorios String?        @db.VarChar(4000)
  registradaPorId    String
  registradaPor      Usuario        @relation(fields: [registradaPorId], references: [id], onDelete: Restrict)
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)

  documentos DocumentoMedico[]

  @@index([atencionId, fechaHora])
  // Historial de Consultas: rango de fechas con paginación por (fechaHora desc, id desc).
  @@index([fechaHora, id])
  @@index([ninoId])
  @@index([citaId])
}

model DocumentoMedico {
  id            String              @id @default(uuid())
  consultaId    String
  consulta      ConsultaMedica      @relation(fields: [consultaId], references: [id], onDelete: Restrict)
  nombreVisible String              @db.VarChar(120)
  // Solo para mostrar — nunca forma parte de la clave del objeto.
  nombreArchivo String              @db.VarChar(255)
  // "medica/{expedienteId}/{atencionId}/{uuid}"
  claveObjeto   String              @unique @db.VarChar(255)
  mimeType      String              @db.VarChar(100)
  tamanioBytes  Int
  subidoPorId   String
  subidoPor     Usuario             @relation(fields: [subidoPorId], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  @@index([consultaId])
}

// Documento subido mientras se llena una consulta que aún no se guarda. Al guardar, la misma
// transacción lo convierte en `DocumentoMedico` y borra esta fila (la clave en R2 no cambia).
// La limpieza diaria borra fila y objeto vencidos para no dejar archivos clínicos huérfanos.
model DocumentoMedicoPendiente {
  id            String              @id @default(uuid())
  // Agrupa los documentos de un mismo formulario de consulta.
  lote          String              @db.Uuid
  nombreVisible String              @db.VarChar(120)
  nombreArchivo String              @db.VarChar(255)
  // "medica/{expedienteId}/{atencionId}/{uuid}" — ya definitiva al subir.
  claveObjeto   String              @unique @db.VarChar(255)
  mimeType      String              @db.VarChar(100)
  tamanioBytes  Int
  atencionId    String
  subidoPorId   String
  subidoPor     Usuario             @relation(fields: [subidoPorId], references: [id], onDelete: Restrict)
  expiraEn      DateTime            @db.Timestamptz(3)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)

  @@index([lote, subidoPorId])
  @@index([expiraEn])
}
